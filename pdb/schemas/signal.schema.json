{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal",
  "description": "A structured unit of open-source intelligence produced by a collector agent.",
  "type": "object",
  "required": ["headline", "summary", "why_it_matters", "beat", "region", "sector", "sources", "status", "confidence", "materiality"],
  "properties": {
    "id": { "type": "string", "description": "beat-slug, e.g. 'macro-cb/boj-ycc-tweak'" },
    "headline": { "type": "string", "maxLength": 140 },
    "summary": { "type": "string", "description": "2-4 sentences, numbers over adjectives" },
    "why_it_matters": { "type": "string", "description": "Macro transmission channel: why a rational generalist should care" },
    "beat": { "type": "string" },
    "region": { "type": "string" },
    "sector": { "type": "string" },
    "status": { "enum": ["confirmed", "reported", "disputed"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "materiality": { "type": "integer", "minimum": 1, "maximum": 5, "description": "5 = reshapes a macro trend; 1 = notable background" },
    "novelty": { "type": "string", "description": "What is actually new vs. the standing situation" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "publisher", "grade"],
        "properties": {
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "grade": { "type": "string", "pattern": "^[A-F][1-6]$", "description": "reliability/credibility per METHODOLOGY.md §2" },
          "published_at": { "type": "string" }
        }
      }
    },
    "data_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value"],
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string" },
          "as_of": { "type": "string" },
          "source_url": { "type": "string" }
        }
      }
    }
  }
}
